// ┏┓╻+╻ ╱┏┳┓┏┓┏┳┓┏┓╻
// ┃┃┃┃┗━┓╹┃╹┣┫┃┃┃┣┫┃   Read the manpage:
// ╹┗┛╹╱ ╹ ╹ ╹╹╹ ╹╹╹┗┛  $ man nixtamal-manifest
version "1.5.0"
default-gc track
inputs {
	nixpkgs {
		archive {
			url "{{fresh_value}}/nixexprs.tar.zst"
		}
		hash algorithm=SHA-256
		fresh-cmd {
			$ curl -Ls --http2 --compressed -o "/dev/null" -w "%{url_effective}" "https://channels.nixos.org/nixpkgs-unstable"
		}
	}
	dash-nix {
		darcs {
			repository "https://darcs.toastal.in.th/dash-nix"
			mirrors "https://smeder.ee/~toastal/dash-nix.darcs" "https://hub.darcs.net/toastal/darcs-nix"
		}
		fresh-cmd {
			$ curl -fsL "https://darcs.toastal.in.th/dash-nix/_darcs/weak_hash"
		}
	}
}


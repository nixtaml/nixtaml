# http://editorconfig.org/

# Tabs are preferred where possible; this is the only accessible choice

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = tab
trim_trailing_whitespace = true

[*.{patch,rst}]
indent_style = unset
indent_size = unset

[LICENSE.txt]
indent_style = unset
indent_size = unset

# fish brings a formatter that does 4-space
[*.fish]
indent_style = space
indent_size = 4

[dune]
indent_style = space
indent_size = 1

[dune-project]
indent_style = space
indent_size = 1

[dune-workspace]
indent_style = space
indent_size = 1
